    { "source": "/about.html", "destination": "/frontend/about.html" },
    { "source": "/article.html", "destination": "/frontend/article.html" },
    { "source": "/article-view.html", "destination": "/frontend/article-view.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/register.html", "destination": "/frontend/register.html" },
    { "source": "/forgot-password.html", "destination": "/frontend/forgot-password.html" },
    { "source": "/dashboard.html", "destination": "/frontend/dashboard.html" },
    { "source": "/articles.html", "destination": "/frontend/articles.html" },
    { "source": "/media.html", "destination": "/frontend/media.html" },
    { "source": "/archive.html", "destination": "/frontend/archive.html" },
    { "source": "/correspondents.html", "destination": "/frontend/correspondents.html" },

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        (request.auth.uid == userId
          // Self-registration requires the 6-digit email code (api/verify-code.js sets this).
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.email.matches('^[^@]+@gordoncollege.edu.ph$')
          && request.resource.data.role in ['correspondent', 'pending_editorial']
          && request.resource.data.status == (request.resource.data.role == 'pending_editorial' ? 'pending' : 'active')
          && request.resource.data.keys().hasOnly([
            'firstName', 'surname', 'name', 'email', 'role', 'status', 'section', 'createdAt'
          ]))
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          && request.resource.data.email.matches('^[^@]+@gordoncollege.edu.ph$')
          && request.resource.data.role == 'correspondent'
          && request.resource.data.status == 'invited'
          && request.resource.data.keys().hasOnly([
            'firstName', 'surname', 'name', 'email', 'role', 'status', 'section', 'createdAt'
          ]))
      );
      allow update: if request.auth != null && (
        // Adviser may update any user
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active')
        // Users may update profile fields, but not their role, status, or email.
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'surname', 'name', 'section', 'program', 'yearJoined', 'photoURL', 'notificationPreferences', 'updatedAt'
          ]))
        && (!request.resource.data.keys().hasAny(['notificationPreferences'])
          || (request.resource.data.notificationPreferences is map
            && request.resource.data.notificationPreferences.keys().hasOnly([
              'articlePublished', 'articleReturned', 'articleAssigned'
            ])
            && request.resource.data.notificationPreferences.articlePublished is bool
            && request.resource.data.notificationPreferences.articleReturned is bool
            && request.resource.data.notificationPreferences.articleAssigned is bool))
      );
      allow delete: if request.auth != null && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
        // A new account may remove the invited placeholder that was created for the same email.
        || (resource.data.status == 'invited' && resource.data.email == request.auth.token.email)
      );
    }

    // Articles collection
    match /articles/{articleId} {
      function writerIdentityUnchangedAfterForward() {
        let isForwarded = resource.data.get('status', '') in ['pending_adviser', 'published']
          || request.resource.data.get('status', '') in ['pending_adviser', 'published']
          || resource.data.get('approvedByEditorialAt', null) != null;
        return !isForwarded || (
          request.resource.data.get('writerName', null) == resource.data.get('writerName', null)
          && request.resource.data.get('authorName', null) == resource.data.get('authorName', null)
          && request.resource.data.get('authorId', null) == resource.data.get('authorId', null)
          && request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null)
        );
      }

      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isActive(role) {
        return me().role == role && me().get('status', 'active') == 'active';
      }

      // Only editors assign articles, and only to active correspondents or co-editors.
      function assigneeUnchanged() {
        return request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null);
      }

      function validAssignee() {
        let assignee = request.resource.data.get('assignedTo', null);
        return assignee == null || assignee == ''
          || (get(/databases/$(database)/documents/users/$(assignee)).data.role in ['correspondent', 'editorial']
            && get(/databases/$(database)/documents/users/$(assignee)).data.get('status', '') == 'active');
      }

      // Who assigned the article (assignedBy / assignedByName / assignedAt) only changes
      // together with the assignee, and only to the editor making that change.
      function assignmentRecordUnchanged() {
        return request.resource.data.get('assignedBy', null) == resource.data.get('assignedBy', null)
          && request.resource.data.get('assignedByName', null) == resource.data.get('assignedByName', null)
          && request.resource.data.get('assignedAt', null) == resource.data.get('assignedAt', null);
      }

      function assignmentRecordedBySelf() {
        let assignee = request.resource.data.get('assignedTo', null);
        return (assignee == null || assignee == '')
          ? request.resource.data.get('assignedBy', null) == null
          : request.resource.data.get('assignedBy', null) == request.auth.uid;
      }

      // An editor may not take over an article another editor assigned.
      function assignedBySelfOrNobody() {
        return resource.data.get('assignedBy', null) in [null, request.auth.uid];
      }

      // Only the editor who assigned an article may forward it to the adviser. Articles that
      // no editor assigned (self-submitted, or assigned before assignedBy existed) are open
      // to any editor.
      function forwardAllowed() {
        let forwarding = request.resource.data.get('status', '') == 'pending_adviser'
          && resource.data.get('status', '') != 'pending_adviser';
        return !forwarding || assignedBySelfOrNobody();
      }

      // The creator of an unpublished article may soft-delete it (status "deleted").
      function isCreatorSoftDelete() {
        return resource.data.get('authorId', null) == request.auth.uid
          && resource.data.get('status', 'draft') != 'published'
          && request.resource.data.get('status', '') == 'deleted'
          && request.resource.data.get('deletedBy', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'deletedAt', 'deletedBy', 'updatedAt']);
      }

      function publicAccessEnabled() {
        return !exists(/databases/$(database)/documents/settings/publication)
          || get(/databases/$(database)/documents/settings/publication).data.publicArticleAccess == true;
      }

      allow read: if (resource.data.status == 'published' && publicAccessEnabled()) || (request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adviser', 'editorial']
          || resource.data.authorId == request.auth.uid
          || resource.data.assignedTo == request.auth.uid
        ));
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adviser', 'editorial', 'correspondent']
        && request.resource.data.authorId == request.auth.uid
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editorial'
          ? validAssignee() && assignmentRecordedBySelf()
          : request.resource.data.get('assignedTo', null) in [null, '']
            && request.resource.data.get('assignedBy', null) == null);
      allow update: if request.auth != null && writerIdentityUnchangedAfterForward() && (
        // Adviser may update (and soft-delete) anything except the assignment.
        (isActive('adviser')
          && assigneeUnchanged()
          && assignmentRecordUnchanged())
        // Editorial staff may manage and assign articles but cannot publish, delete articles
        // they did not create, replace the author, take over another editor's assignment, or
        // forward an article another editor assigned.
        || (isActive('editorial')
          && request.resource.data.status != 'published'
          && request.resource.data.status != 'deleted'
          && request.resource.data.authorId == resource.data.authorId
          && ((assigneeUnchanged() && assignmentRecordUnchanged())
            || (validAssignee() && assignmentRecordedBySelf() && assignedBySelfOrNobody()))
          && forwardAllowed())
        // Correspondents may edit their own or assigned drafts and submit them for review.
        || (isActive('correspondent')
          && (resource.data.authorId == request.auth.uid || resource.data.get('assignedTo', null) == request.auth.uid)
          && request.resource.data.authorId == resource.data.authorId
          && assigneeUnchanged()
          && assignmentRecordUnchanged()
          && (
            (resource.data.status in ['draft', 'assigned']
              && request.resource.data.status == resource.data.status)
            || (resource.data.status in ['draft', 'assigned', 'reviewed']
              && request.resource.data.status == 'pending')
            || (resource.data.status == 'pending'
              && request.resource.data.status == 'pending')
            || (resource.data.status == 'reviewed'
              && request.resource.data.status == 'reviewed')
          ))
        // Correspondents and editors may delete unpublished articles they created themselves.
        || ((isActive('correspondent') || isActive('editorial')) && isCreatorSoftDelete())
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';

      // Feedback subcollection
      match /feedback/{fbId} {
        allow read: if request.auth != null && (
          // advisers and editorial can read feedback
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adviser','editorial'])
          // or the feedback sender
          || resource.data.fromUid == request.auth.uid
          // or the article author or assigned correspondent
          || get(/databases/$(database)/documents/articles/$(articleId)).data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/articles/$(articleId)).data.assignedTo == request.auth.uid
        );
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if false; // feedback once written shouldn't be modified by clients
      }

      // Comments on published articles: anyone can read them; only signed-in, active users
      // can post, as themselves. No email is stored. Commenters may delete their own comments,
      // and active advisers may delete any comment (moderation). Comments cannot be edited.
      match /comments/{commentId} {
        function articlePublished() {
          return get(/databases/$(database)/documents/articles/$(articleId)).data.get('status', '') == 'published';
        }
        function commenterProfile() {
          return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }

        allow read: if articlePublished();
        allow create: if request.auth != null
          && articlePublished()
          && commenterProfile().get('status', '') == 'active'
          && request.resource.data.keys().hasOnly(['articleId', 'userId', 'authorName', 'comment', 'createdAt'])
          && request.resource.data.articleId == articleId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName == commenterProfile().get('name', '')
          && request.resource.data.comment is string
          && request.resource.data.comment.trim().size() > 0
          && request.resource.data.comment.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && (
          resource.data.get('userId', null) == request.auth.uid
          || (commenterProfile().get('role', '') == 'adviser'
            && commenterProfile().get('status', '') == 'active')
        );
        allow update: if false;
      }
    }

    // Public contributor profiles, read by the public portal without signing in.
    // users/{uid} cannot be made public (Firestore rules cannot hide single fields, and it
    // holds emails), so this collection holds a copy of the display fields only. A copy is
    // accepted only if every field equals the user's own profile and the account is active
    // staff, so it can never show a name, photo or role the user does not really have.
    match /public_profiles/{uid} {
      function profileOwner() {
        return get(/databases/$(database)/documents/users/$(uid)).data;
      }
      function isActiveAdviser() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'adviser'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active';
      }
      function mirrorsOwner() {
        let owner = profileOwner();
        let next = request.resource.data;
        return next.keys().hasOnly([
            'name', 'firstName', 'surname', 'photoURL', 'section', 'sections', 'bio', 'role', 'updatedAt'
          ])
          && owner.get('status', '') == 'active'
          && owner.get('role', '') in ['correspondent', 'editorial', 'adviser']
          && next.get('name', null) == owner.get('name', null)
          && next.get('firstName', null) == owner.get('firstName', null)
          && next.get('surname', null) == owner.get('surname', null)
          && next.get('photoURL', null) == owner.get('photoURL', null)
          && next.get('section', null) == owner.get('section', null)
          && next.get('sections', null) == owner.get('sections', null)
          && next.get('bio', null) == owner.get('bio', null)
          && next.get('role', null) == owner.get('role', null)
          && next.updatedAt == request.time;
      }

      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.uid == uid || isActiveAdviser())
        && mirrorsOwner();
      allow delete: if request.auth != null && (request.auth.uid == uid || isActiveAdviser());
    }

    // Audit log — clients may write audit entries, but never read or modify them
    match /audit_log/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Notifications
    match /notifications/{notifId} {
      allow create: if request.auth != null
        && request.resource.data.toUid is string
        && request.resource.data.toUid != ''
        && request.resource.data.type is string
        && request.resource.data.message is string
        && request.resource.data.read == false
        && (request.resource.data.fromUid == request.auth.uid || request.resource.data.fromUid == null);
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['read', 'updatedAt'])
        && request.resource.data.read == true;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /settings/{settingId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
      allow create, update: if request.auth != null
        && settingId == 'publication'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'adviser'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && request.resource.data.keys().hasOnly([
          'publicationName', 'contactEmail', 'publicArticleAccess', 'updatedAt'
        ])
        && request.resource.data.publicationName is string
        && request.resource.data.contactEmail is string
        && request.resource.data.publicArticleAccess is bool;
      allow delete: if false;
    }

    // Media library
    match /media/{mediaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.filename is string
        && request.resource.data.url is string;
      // The uploader may edit or delete their own media; active advisers and editors may
      // manage anyone's (e.g. Media Library single and bulk delete).
      allow update, delete: if request.auth != null && (
        resource.data.uploadedBy == request.auth.uid
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adviser', 'editorial']
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active')
      );
    }

    // Email verification codes: server-only (Admin SDK in api/). No client access.
    match /email_verifications/{uid} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
